import { AppError } from "./errors";
/**
 * Plan entitlements + enforcement. Plans match the public pricing page.
 * Limits are enforced in services (not UI) so the UI simply reflects reality.
 */

export type PlanId = "FREE" | "MAKER" | "GROWTH" | "PRO";

export type Plan = {
  id: PlanId;
  name: string;
  priceCents: number;
  tagline: string;
  limits: {
    products: number;
    opportunitiesSurfaced: number; // per scan day
    aiCreditsPerMonth: number;
    seats: number;
    experiments: number;
    competitors: number;
    liveDiscovery: boolean;
    api: boolean;
    automation: boolean;
    crm: boolean;
  };
  features: string[];
  cta: string;
};

