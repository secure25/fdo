# --- Database (SQLite by default; swap the Prisma datasource to Postgres for managed deploys) ---
DATABASE_URL="file:./dev.db"

# --- Auth: random 32+ char secret used to sign session cookies ---
AUTH_SECRET="dev-secret-change-me-in-production-9f2c1a"

# --- Public URL (used for webhooks + links) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- AI provider (optional). Any OpenAI-compatible endpoint works:
#     OpenAI, Azure OpenAI gateways, Groq, Z.AI, local llama.cpp, etc.
#     When unset, the platform runs on its deterministic built-in intelligence engine. ---
# AI_API_KEY="sk-..."
# AI_BASE_URL="https://api.openai.com/v1"
# AI_MODEL="gpt-4o-mini"
#
# Free testing option — NVIDIA NIM (build.nvidia.com, key starts with nvapi-):
# AI_API_KEY="nvapi-..."
# AI_BASE_URL="https://integrate.api.nvidia.com/v1"
# AI_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"
# Verify with: node scripts/ai-smoke.mjs

# --- Paddle (optional; recommended for sellers outside Stripe's countries, e.g. South Africa).
#     Paddle Billing acts as merchant of record: global cards/PayPal/Apple Pay + sales tax & VAT handled. ---
# PADDLE_ENV="sandbox"            # or "production" (switches api/sandbox-api + buy/sandbox-buy domains)
# PADDLE_API_KEY="pdl_sdbx_..."   # Developer tools > API keys
# PADDLE_WEBHOOK_SECRET="pdl_ntfset_..."  # from the notification destination
# PADDLE_PRICE_MAKER="pri_..."    # recurring monthly price, $15
# PADDLE_PRICE_GROWTH="pri_..."   # recurring monthly price, $39
# PADDLE_PRICE_PRO="pri_..."      # recurring monthly price, $99

# --- Stripe (optional; when unset, plan changes use built-in simulated checkout) ---
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Firecrawl (optional) — powers the deep-research pipeline (site scrape + web search).
#     WITHOUT a key: uses the official firecrawl-cli free keyless tier — install once with
#     `npx -y firecrawl-cli@latest init --all --browser` (rate-limited per IP).
#     WITH a key: calls the hosted API directly (production-grade limits).
#     Deep research (FETCH_SITE → RESEARCH → AI_ANALYZE jobs) runs automatically after
#     onboarding and upgrades the baseline analysis with real website + market evidence. ---
# FIRECRAWL_API_KEY="fc-..."
# FIRECRAWL_CLI_PATH="C:\\...\\npm\\node_modules\\firecrawl-cli\\dist\\index.js"  # only if auto-detect fails

# --- Discovery source tokens (optional; public endpoints are used by default) ---
# REDDIT_ACCESS_TOKEN="..."
#
# Going live checklist:
# 1. Payments (Paddle — works from South Africa and most countries):
#    create one recurring monthly price per plan (Maker $15, Growth $39, Pro $99), paste the
#    pri_… IDs above, then add a notification destination at
#    {NEXT_PUBLIC_APP_URL}/api/billing/webhook/paddle subscribed to transaction.completed and
#    subscription.* events, and paste its secret key. Sandbox uses sandbox-api.paddle.com.
# 1b. Payments (Stripe alternative): create 3 recurring Prices with lookup keys maker_monthly /
#    growth_monthly / pro_monthly ($15/$39/$99), set STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET, and
#    point a webhook at {NEXT_PUBLIC_APP_URL}/api/billing/webhook (checkout.session.completed,
#    customer.subscription.updated).
# 2. LLM: set AI_API_KEY (any OpenAI-compatible endpoint). Every analyst upgrades automatically;
#    the deterministic engine stays as fallback.
# 3. Live discovery: Hacker News works out of the box (public Algolia API). Reddit uses public
#    JSON by default; set REDDIT_ACCESS_TOKEN for authenticated requests, and review Reddit's
#    API terms for commercial-scale use.
